---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { categories, getSlug } from '../../utils/categories.js';
import { getImageSet } from '../../utils/images.js';

export async function getStaticPaths() {
  const allAntiques = await getCollection('antiques');
  return allAntiques.map(item => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);

const images = (data.images || []).map(img => typeof img === 'string' ? img : img.url).reverse();
const imageSets = images.map(img => {
  const optimizedBase = img.replace('/uploads/', '/optimized/');
  return getImageSet(optimizedBase);
});

const category = categories.find(c => c.name === data.category);
const categorySlug = category ? getSlug(category) : 'all';
---

<Layout bodyClass="bg-stone-50">
  <section class="border-b border-stone-200 bg-stone-100 py-6">
    <div class="container mx-auto px-4">
      <nav class="flex flex-wrap items-center gap-2 text-sm text-stone-500" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-amber-700">Начало</a>
        <span>/</span>
        <a href="/categories" class="transition-colors hover:text-amber-700">Категории</a>
        <span>/</span>
        <a href={`/categories/${categorySlug}`} class="transition-colors hover:text-amber-700">{data.category}</a>
        <span>/</span>
        <span class="font-medium text-stone-800">{data.title}</span>
      </nav>
    </div>
  </section>

  <section class="container mx-auto px-4 py-10 sm:py-14 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(360px,0.92fr)] lg:gap-14 xl:gap-20">
      <div class="space-y-5">
        <div class="relative flex aspect-square cursor-zoom-in items-center justify-center overflow-hidden rounded-lg border border-stone-200 bg-white shadow-xl shadow-stone-950/10" data-zoom-frame>
          <img
            src={imageSets[0].medium}
            srcset={`${imageSets[0].small} 400w, ${imageSets[0].medium} 800w, ${imageSets[0].large} 1200w`}
            sizes="(max-width: 1024px) 100vw, 56vw"
            alt={data.title}
            class="h-full w-full object-contain p-4 transition-transform duration-300 sm:p-6"
            id="main-image"
            data-zoom-image
            decoding="async"
            fetchpriority="high"
          />
        </div>

        {imageSets.length > 1 && (
          <div class="grid grid-cols-4 gap-3 sm:grid-cols-5 lg:grid-cols-6">
            {imageSets.map((imgSet, index) => (
              <button
                type="button"
                class="aspect-square overflow-hidden rounded border border-stone-200 bg-white p-1 shadow-sm transition-colors hover:border-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500"
                aria-label={`Покажи снимка ${index + 1}`}
                onclick={`const main = document.getElementById('main-image'); main.src='${imgSet.medium}'; main.srcset='${imgSet.small} 400w, ${imgSet.medium} 800w, ${imgSet.large} 1200w';`}
              >
                <img src={imgSet.small} alt={`${data.title} - ${index + 1}`} class="h-full w-full object-cover" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        )}
      </div>

      <aside class="lg:sticky lg:top-32 lg:self-start">
        <div class="rounded-lg border border-stone-200 bg-white p-6 shadow-xl shadow-stone-950/10 sm:p-8">
          <div class="mb-5 flex flex-wrap gap-2">
            {data.subcategory && (
              <span class="rounded bg-amber-100 px-3 py-1 text-xs font-bold uppercase tracking-wide text-amber-900">
                {data.subcategory}
              </span>
            )}

            {data.new && (
              <span class="rounded bg-stone-900 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
                Ново
              </span>
            )}

            {data.featured && (
              <span class="rounded bg-[#D4AF37] px-3 py-1 text-xs font-bold uppercase tracking-wide text-stone-950">
                Препоръчано
              </span>
            )}

            {data.available === false && (
              <span class="rounded bg-red-100 px-3 py-1 text-xs font-bold uppercase tracking-wide text-red-800">
                Продадено
              </span>
            )}
          </div>

          <h1 class="font-serif text-3xl font-bold leading-tight text-stone-950 sm:text-4xl lg:text-5xl">{data.title}</h1>
          <p class="mt-5 font-serif text-3xl font-bold text-[#8a6a24]">€{data.price?.toLocaleString()}</p>

          <div class="mt-8 grid gap-3 border-y border-stone-200 py-5 text-sm text-stone-600 sm:grid-cols-2">
            <div>
              <span class="block font-semibold text-stone-900">Категория</span>
              {data.category}
            </div>
            {data.subcategory && (
              <div>
                <span class="block font-semibold text-stone-900">Подкатегория</span>
                {data.subcategory}
              </div>
            )}
            <div>
              <span class="block font-semibold text-stone-900">Наличност</span>
              {data.available === false ? 'Продадено' : 'Налично'}
            </div>
          </div>

          <div class="mt-7">
            <h2 class="font-serif text-xl font-bold text-stone-950">Описание</h2>
            <p class="mt-3 border-l-4 border-amber-600/50 pl-4 text-base leading-relaxed text-stone-600">
              {data.description}
            </p>
          </div>

          <a
            href={`/contact?subject=Запитване за: ${encodeURIComponent(data.title)}`}
            class="mt-8 inline-flex w-full justify-center rounded bg-stone-900 px-6 py-4 text-sm font-bold uppercase tracking-wide text-white shadow-lg shadow-stone-950/15 transition-colors hover:bg-[#8a6a24]"
          >
            Запитване за продукта
          </a>
        </div>
      </aside>
    </div>

    <div class="mt-10 rounded-lg border border-stone-200 bg-white p-6 shadow-sm sm:p-8 lg:mt-14">
      <h2 class="mb-5 flex items-center gap-2 border-b border-stone-100 pb-4 font-serif text-2xl font-bold text-stone-950">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Подробности за продукта
      </h2>
      <div class="content-render text-stone-700">
        <Content />
      </div>
    </div>
  </section>

  <script>
    const zoomFrame = document.querySelector<HTMLElement>('[data-zoom-frame]');
    const zoomImage = document.querySelector<HTMLImageElement>('[data-zoom-image]');

    if (zoomFrame && zoomImage) {
      zoomFrame.addEventListener('mousemove', (event: MouseEvent) => {
        const rect = zoomFrame.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;

        zoomImage.style.transformOrigin = `${x}% ${y}%`;
        zoomImage.style.transform = 'scale(1.65)';
      });

      zoomFrame.addEventListener('mouseleave', () => {
        zoomImage.style.transformOrigin = 'center center';
        zoomImage.style.transform = 'scale(1)';
      });
    }
  </script>
</Layout>

<style>
  .content-render :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
  }

  .content-render :global(h1),
  .content-render :global(h2),
  .content-render :global(h3) {
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
    font-weight: bold;
    color: #1c1917;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
</style>
