---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { categories, getSlug } from '../../utils/categories.js';
import { getImageSet } from '../../utils/images.js';

export async function getStaticPaths() {
  const allAntiques = await getCollection('antiques');
  return allAntiques.map(item => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;
const { Content } = await render(item);

// Mocking views for now if not present or 0
const views = data.views || Math.floor(Math.random() * 500) + 100;

// Supporting 1 or more images from the new 'images' field
const images = (data.images || []).map(img => typeof img === 'string' ? img : img.url);
const imageSets = images.map(img => {
  // Transform /uploads/ to /optimized/ so getImageSet produces correct paths
  const optimizedBase = img.replace('/uploads/', '/optimized/');
  return getImageSet(optimizedBase);
});

// Find category slug for breadcrumbs
const category = categories.find(c => c.name === data.category);
const categorySlug = category ? getSlug(category) : 'all';
---

<Layout>
  <div class="py-12 bg-stone-100 border-b border-stone-200">
    <div class="container mx-auto px-4">
      <div class="text-sm text-stone-500 mb-4">
        <a href="/" class="hover:text-amber-700">Начало</a> / 
        <a href="/categories" class="hover:text-amber-700">Категории</a> / 
        <a href={`/categories/${categorySlug}`} class="hover:text-amber-700">{data.category}</a> /
        <span class="text-stone-800">{data.title}</span>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Left: Images -->
      <div class="space-y-6">
        <div class="aspect-square bg-white border border-stone-200 rounded-lg overflow-hidden shadow-sm flex items-center justify-center relative">
          <img 
            src={imageSets[0].medium} 
            srcset={`${imageSets[0].small} 400w, ${imageSets[0].medium} 800w, ${imageSets[0].large} 1200w`}
            sizes="(max-width: 768px) 100vw, 50vw"
            alt={data.title} 
            class="max-w-full max-h-full object-contain p-4 transition-all duration-500" 
            id="main-image" 
          />
        </div>
        
        {imageSets.length > 1 && (
          <div class="grid grid-cols-4 gap-4">
            {imageSets.map((imgSet, index) => (
              <button 
                class="aspect-square bg-white border border-stone-200 rounded cursor-pointer overflow-hidden hover:border-amber-700 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
                onclick={`const main = document.getElementById('main-image'); main.src='${imgSet.medium}'; main.srcset='${imgSet.small} 400w, ${imgSet.medium} 800w, ${imgSet.large} 1200w';`}
              >
                <img src={imgSet.small} alt={`${data.title} - ${index + 1}`} class="w-full h-full object-cover p-1" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Right: Product Info -->
      <div class="flex flex-col h-full">
        <div class="mb-8">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="px-3 py-1 bg-amber-100 text-amber-800 text-xs font-bold uppercase tracking-wider rounded-full">
              {data.subcategory}
            </span>
            
            {data.new && (
              <span class="px-3 py-1 bg-green-100 text-green-800 text-xs font-bold uppercase tracking-wider rounded-full flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                Ново
              </span>
            )}

            {data.featured && (
              <span class="px-3 py-1 bg-purple-100 text-purple-800 text-xs font-bold uppercase tracking-wider rounded-full flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 17.5 9.134a1 1 0 010 1.732l-3.354 1.935-1.18 4.455a1 1 0 01-1.933 0L9.854 12.8 6.5 10.866a1 1 0 010-1.732l3.354-1.935 1.18-4.455A1 1 0 0112 2z" clip-rule="evenodd" />
                </svg>
                Препоръчано
              </span>
            )}

            {data.available === false && (
              <span class="px-3 py-1 bg-red-100 text-red-800 text-xs font-bold uppercase tracking-wider rounded-full">
                Продадено
              </span>
            )}
            
            <span class="text-stone-400 text-sm flex items-center gap-1 ml-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              {views} прегледа
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl font-serif font-bold text-stone-800 mb-4">{data.title}</h1>
          <p class="text-3xl font-serif text-amber-800 font-bold mb-8">€{data.price?.toLocaleString()}</p>
          
          <div class="prose prose-stone max-w-none text-stone-600 mb-10">
            <div class="bg-white p-8 rounded-lg border border-stone-200 shadow-sm">
                <h3 class="text-stone-800 font-serif font-bold mb-6 border-b border-stone-100 pb-2 flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  Описание на продукта
                </h3>
                <div class="mb-6 italic text-stone-500 border-l-4 border-stone-100 pl-4 py-2">
                  {data.description}
                </div>
                <div class="content-render">
                    <Content />
                </div>
            </div>
          </div>
        </div>

        <div class="mt-auto pt-8 border-t border-stone-200 space-y-6">
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href={`/contact?subject=Запитване за: ${encodeURIComponent(data.title)}`}
              class="flex-grow bg-stone-800 hover:bg-stone-900 text-white py-4 rounded font-bold transition-all shadow-lg text-lg uppercase tracking-wider text-center"
            >
              Запитване за продукта
            </a>
          </div>
          
          
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
    .content-render :global(p) {
        margin-bottom: 1rem;
    }
    .content-render :global(h1), 
    .content-render :global(h2), 
    .content-render :global(h3) {
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
        font-weight: bold;
        color: #1c1917;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
    }
</style>
