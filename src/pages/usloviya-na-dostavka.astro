---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="bg-stone-100 py-16 sm:py-20">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl">
        <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.24em] text-amber-700">Условия</span>
        <h1 class="font-serif text-4xl font-bold text-stone-900 sm:text-5xl">Условия на доставка</h1>
        <div class="mt-8 space-y-5 text-base leading-relaxed text-stone-700">
          <!-- <p>Доставката се организира според размера, стойността и състоянието на конкретния предмет.</p>
          <p>Преди изпращане уточняваме с клиента подходящ начин на транспорт, срок и необходимата опаковка, за да бъде артикулът защитен максимално добре.</p> -->
        </div>
      </div>
    </div>
  </section>
</Layout>
