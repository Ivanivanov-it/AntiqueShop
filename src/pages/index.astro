---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allAntiques = await getCollection('antiques');
const sortByRecentDate = (a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  if (dateA !== dateB) return dateB - dateA;
  return b.id.localeCompare(a.id);
};

const featuredItems = allAntiques
  .filter((item) => item.data.featured)
  .sort(sortByRecentDate)
  .slice(0, 4);

const newestItems = allAntiques
  .sort(sortByRecentDate)
  .slice(0, 4);
---

<Layout bodyClass="bg-[#003000]">
  <!-- Hero Section -->
  <section class="relative h-[80vh] flex items-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/hero-image.png" 
        alt="Elegant Antique Living Room" 
        class="w-full h-full object-cover"
      />
    </div>
    
    <!-- Blur Overlay (Left side only) -->
    <div class="absolute inset-y-0 left-0 w-full md:w-2/3 backdrop-blur-[3px] z-10 [mask-image:linear-gradient(to_right,black_50%,transparent)]"></div>
    
    <!-- Gradient Overlay: Darker on the left for text readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-stone-950/90 via-stone-950/40 to-transparent z-20"></div>
    
    <div class="relative z-30 container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-7xl font-serif font-bold mb-4 drop-shadow-lg leading-tight">
          Истории, запазени във времето
        </h1>
        
        <!-- Fancy Breakline -->
        <div class="flex items-center gap-4 mb-8 max-w-2xl">
          <div class="h-[1px] flex-grow bg-gradient-to-r from-transparent via-amber-500/50 to-amber-500"></div>
          <div class="w-3 h-3 rotate-45 border border-amber-500 flex-shrink-0"></div>
          <div class="h-[1px] flex-grow bg-gradient-to-l from-transparent via-amber-500/50 to-amber-500"></div>
        </div>

        <p class="text-xl md:text-2xl mb-10 max-w-2xl drop-shadow-md text-stone-100 leading-relaxed">
          Открийте редки антики и артефакти, които носят следи от минали епохи, култури и човешки ръце.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/categories" class="bg-[#c5a059] hover:bg-[#d4af37] text-stone-950 px-10 py-4 rounded font-bold transition-all shadow-lg transform hover:scale-105 text-center">
            Разгледайте колекцията
          </a>          <a href="/about" class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 px-10 py-4 rounded font-bold transition-all text-center">
            Нашата история
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Items Section -->
  <section class="bg-[#003000] py-16 sm:py-20 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mb-10 flex flex-col gap-6 border-b border-white/10 pb-8 sm:mb-12 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.24em] text-[#c5a059]">
            Подбрани антики
          </span>
          <h2 class="font-serif text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
            Избрани предмети
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-stone-300 sm:text-lg">
            Най-новите акценти от колекцията, отбелязани като специално подбрани заради произход, майсторство и силно присъствие.
          </p>
        </div>
        <a href="/categories" class="inline-flex w-fit items-center justify-center rounded border border-[#c5a059]/70 px-5 py-3 text-sm font-bold uppercase tracking-wide text-[#c5a059] transition-all hover:bg-[#c5a059] hover:text-[#003000]">
          Виж всички
          <span class="ml-2" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featuredItems.map((item) => (
          <article class="group overflow-hidden rounded-lg border border-stone-200 bg-stone-50 shadow-xl shadow-black/10 transition-all duration-300 hover:-translate-y-1 hover:border-[#c5a059]/70 hover:bg-white">
            <a href={`/antiques/${item.id}`} class="block">
              <div class="relative aspect-[4/5] overflow-hidden bg-stone-900">
                {item.data.images && item.data.images.length > 0 ? (
                  <img
                    src={typeof item.data.images[item.data.images.length - 1] === 'string' ? item.data.images[item.data.images.length - 1] : item.data.images[item.data.images.length - 1].url}
                    alt={item.data.title}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center px-6 text-center text-sm italic text-stone-500">
                    [Няма изображение]
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-stone-950/75 via-stone-950/5 to-transparent opacity-80"></div>
                <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-3">
                  <span class="rounded bg-white/95 px-3 py-2 text-xs font-bold uppercase tracking-wide text-stone-900 shadow-lg">
                    Виж детайли
                  </span>
                  <span class="h-px flex-1 bg-[#c5a059]/70"></span>
                </div>
              </div>
              <div class="p-5">
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">
                  {item.data.subcategory}
                </p>
                <h3 class="min-h-14 font-serif text-xl font-bold leading-snug text-stone-950 transition-colors group-hover:text-[#8a6a24]">
                  {item.data.title}
                </h3>
                <div class="mt-5 flex items-center justify-between border-t border-stone-200 pt-4">
                  <span class="text-sm text-stone-500">Цена</span>
                  <span class="font-serif text-lg font-bold text-[#8a6a24]">€{item.data.price?.toLocaleString() || 'N/A'}</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- About Highlight Section -->
  <section class="bg-stone-100 py-16 text-stone-950 sm:py-20 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#8a6a24]">
          Антикварен магазин Берлин
        </p>
        <h2 class="mt-4 font-serif text-4xl font-bold leading-tight sm:text-5xl">
          Основан Х година
        </h2>
        <p class="mt-4 text-xl font-semibold text-stone-700 sm:text-2xl">
          Антикварен магазин във Варна
        </p>
        <p class="mx-auto mt-7 max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg">
          Всяка вещ носи контекст, памет и следи от ръката, която я е създала. Подбираме предмети с доказуем характер и ги представяме с внимание към произхода, материала и мястото им в една жива колекция.
        </p>
        <a href="/about" class="mt-9 inline-flex justify-center rounded bg-[#8a6a24] px-8 py-3 text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-[#6f551d]">
          Повече за нас
        </a>
      </div>
    </div>
  </section>

  <!-- New Items Section -->
  <section class="bg-[#003000] py-16 sm:py-20 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mb-10 flex flex-col gap-6 border-b border-white/10 pb-8 sm:mb-12 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.24em] text-[#c5a059]">
            Подбрана колекция
          </span>
          <h2 class="font-serif text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
            Нови постъпления
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-stone-300 sm:text-lg">
            Последните добавени обекти в колекцията, отличаващи се с рядкост, история и изразителен характер.
          </p>
        </div>
        <a href="/categories" class="inline-flex w-fit items-center justify-center rounded border border-[#c5a059]/70 px-5 py-3 text-sm font-bold uppercase tracking-wide text-[#c5a059] transition-all hover:bg-[#c5a059] hover:text-[#003000]">
          Виж всички
          <span class="ml-2" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {newestItems.map((item) => (
          <article class="group overflow-hidden rounded-lg border border-stone-200 bg-stone-50 shadow-xl shadow-black/10 transition-all duration-300 hover:-translate-y-1 hover:border-[#c5a059]/70 hover:bg-white">
            <a href={`/antiques/${item.id}`} class="block">
              <div class="relative aspect-[4/5] overflow-hidden bg-stone-900">
                {item.data.images && item.data.images.length > 0 ? (
                  <img
                    src={typeof item.data.images[item.data.images.length - 1] === 'string' ? item.data.images[item.data.images.length - 1] : item.data.images[item.data.images.length - 1].url}
                    alt={item.data.title}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center px-6 text-center text-sm italic text-stone-500">
                    [Няма изображение]
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-stone-950/75 via-stone-950/5 to-transparent opacity-80"></div>
                <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-3">
                  <span class="rounded bg-white/95 px-3 py-2 text-xs font-bold uppercase tracking-wide text-stone-900 shadow-lg">
                    Виж детайли
                  </span>
                  <span class="h-px flex-1 bg-[#c5a059]/70"></span>
                </div>
              </div>
              <div class="p-5">
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">
                  {item.data.subcategory}
                </p>
                <h3 class="min-h-14 font-serif text-xl font-bold leading-snug text-stone-950 transition-colors group-hover:text-[#8a6a24]">
                  {item.data.title}
                </h3>
                <div class="mt-5 flex items-center justify-between border-t border-stone-200 pt-4">
                  <span class="text-sm text-stone-500">Цена</span>
                  <span class="font-serif text-lg font-bold text-[#8a6a24]">€{item.data.price?.toLocaleString() || 'N/A'}</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="bg-stone-950 py-16 text-white sm:py-20 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-5xl">
        <div class="max-w-3xl">
          <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.24em] text-[#c5a059]">
            Доверие и експертиза
          </span>
          <h2 class="font-serif text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
            Защо да изберете нас
          </h2>
          <p class="mt-5 text-base leading-relaxed text-stone-300 sm:text-lg">
            Работим с внимание към всеки клиент и към всяка вещ. Подхождаме професионално от първия разговор до финалния избор, като даваме ясна, точна и пълна информация за произхода, състоянието, материалите и особеностите на продуктите.
          </p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <div class="rounded-lg border border-white/10 bg-white/[0.04] p-6">
            <h3 class="font-serif text-xl font-bold text-white">Професионално отношение</h3>
            <p class="mt-4 text-sm leading-relaxed text-stone-300">
              Отговаряме коректно, спокойно и подробно, за да може всеки клиент да вземе информирано решение без прибързаност.
            </p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/[0.04] p-6">
            <h3 class="font-serif text-xl font-bold text-white">Пълна информация</h3>
            <p class="mt-4 text-sm leading-relaxed text-stone-300">
              Представяме важните детайли за всеки предмет: история, категория, видими следи от времето, състояние и характерни качества.
            </p>
          </div>
          <div class="rounded-lg border border-white/10 bg-white/[0.04] p-6">
            <h3 class="font-serif text-xl font-bold text-white">Качество на селекцията</h3>
            <p class="mt-4 text-sm leading-relaxed text-stone-300">
              Подбираме антики и колекционерски предмети с автентично присъствие, добра изработка и стойност за дом, интериор или лична колекция.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Details Section -->
  <section class="bg-stone-100 py-16 text-stone-950 sm:py-20 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mb-10 max-w-3xl">
        <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.24em] text-[#8a6a24]">
          Посетете ни
        </span>
        <h2 class="font-serif text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
          Контакти и работно време
        </h2>
        <a href="/contact" class="mt-6 inline-flex justify-center rounded bg-[#8a6a24] px-7 py-3 text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-[#6f551d]">
          Свържете се с нас
        </a>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-lg border border-stone-200 bg-white p-6 shadow-lg shadow-stone-950/5">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded bg-[#8a6a24] text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold">Адрес</h3>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">
            Varna Center Odesos, бул. Княгиня Мария Луиза 5А, 9000 Varna
          </p>
        </div>

        <div class="rounded-lg border border-stone-200 bg-white p-6 shadow-lg shadow-stone-950/5">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded bg-[#8a6a24] text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold">Работно време</h3>
          <div class="mt-3 space-y-3 text-sm leading-relaxed text-stone-600">
            <p>
              <span class="block font-semibold text-stone-800">Понеделник - Петък:</span>
              10:00 - 16:00
            </p>
            <p>
              <span class="block font-semibold text-stone-800">Събота - Неделя:</span>
              Затворено
            </p>
          </div>
        </div>

        <div class="rounded-lg border border-stone-200 bg-white p-6 shadow-lg shadow-stone-950/5">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded bg-[#8a6a24] text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.11 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.62 2.61a2 2 0 0 1-.45 2.11L8 9.72a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.84.29 1.72.5 2.61.62A2 2 0 0 1 22 16.92Z"></path>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold">Телефон</h3>
          <a href="tel:+359895361505" class="mt-3 inline-block text-sm font-semibold text-stone-600 transition-colors hover:text-[#8a6a24]">
            +359 895361505
          </a>
        </div>

        <div class="rounded-lg border border-stone-200 bg-white p-6 shadow-lg shadow-stone-950/5">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded bg-[#8a6a24] text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a2 2 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-bold">Email</h3>
          <a href="mailto:antiqueshop.berlin@gmail.com" class="mt-3 inline-block break-words text-sm font-semibold text-stone-600 transition-colors hover:text-[#8a6a24]">
            antiqueshop.berlin@gmail.com
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
