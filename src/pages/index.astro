---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allAntiques = await getCollection('antiques');
const newestItems = allAntiques
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    if (dateA !== dateB) return dateB - dateA;
    return b.id.localeCompare(a.id); // Fallback to ID sorting
  })
  .slice(0, 4);
---

<Layout bodyClass="bg-[#003000]">
  <!-- Hero Section -->
  <section class="relative h-[80vh] flex items-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/hero-image.png" 
        alt="Elegant Antique Living Room" 
        class="w-full h-full object-cover"
      />
    </div>
    
    <!-- Blur Overlay (Left side only) -->
    <div class="absolute inset-y-0 left-0 w-full md:w-2/3 backdrop-blur-[3px] z-10 [mask-image:linear-gradient(to_right,black_50%,transparent)]"></div>
    
    <!-- Gradient Overlay: Darker on the left for text readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-stone-950/90 via-stone-950/40 to-transparent z-20"></div>
    
    <div class="relative z-30 container mx-auto px-4 text-white">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-7xl font-serif font-bold mb-4 drop-shadow-lg leading-tight">
          Истории, запазени във времето
        </h1>
        
        <!-- Fancy Breakline -->
        <div class="flex items-center gap-4 mb-8 max-w-2xl">
          <div class="h-[1px] flex-grow bg-gradient-to-r from-transparent via-amber-500/50 to-amber-500"></div>
          <div class="w-3 h-3 rotate-45 border border-amber-500 flex-shrink-0"></div>
          <div class="h-[1px] flex-grow bg-gradient-to-l from-transparent via-amber-500/50 to-amber-500"></div>
        </div>

        <p class="text-xl md:text-2xl mb-10 max-w-2xl drop-shadow-md text-stone-100 leading-relaxed">
          Открийте редки антики и артефакти, които носят следи от минали епохи, култури и човешки ръце.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/categories" class="bg-[#c5a059] hover:bg-[#d4af37] text-stone-950 px-10 py-4 rounded font-bold transition-all shadow-lg transform hover:scale-105 text-center">
            Разгледайте колекцията
          </a>          <a href="/about" class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 px-10 py-4 rounded font-bold transition-all text-center">
            Нашата история
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Section -->
  <section class="py-24 bg-[#003000]">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="max-w-xl">
          <h2 class="text-4xl font-serif font-bold text-white mb-4">Нови постъпления</h2>
          <p class="text-stone-300">Последните добавени обекти в колекцията, отличаващи се с рядкост, история и изразителен характер.</p>
        </div>
        <a href="/categories" class="text-amber-500 font-bold border-b-2 border-amber-500 pb-1 hover:text-amber-400 hover:border-amber-400 transition-all">
          Виж всички артикули &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {newestItems.map((item) => (
          <div class="group cursor-pointer">
            <div class="aspect-[3/4] bg-stone-800 mb-4 overflow-hidden rounded shadow-sm relative border border-white/5">
              {item.data.images && item.data.images.length > 0 ? (
                <img 
                  src={typeof item.data.images[item.data.images.length - 1] === 'string' ? item.data.images[item.data.images.length - 1] : item.data.images[item.data.images.length - 1].url} 
                  alt={item.data.title} 
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center text-stone-500 italic">
                  [Няма изображение]
                </div>
              )}
              <div class="absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/20 transition-all duration-300"></div>
              <div class="absolute bottom-4 left-4 right-4 translate-y-full group-hover:translate-y-0 transition-all duration-300">
                <a href={`/antiques/${item.id}`} class="block w-full bg-white text-stone-800 py-2 rounded text-center text-sm font-bold shadow-md hover:bg-stone-100 transition-colors">
                  Виж детайли
                </a>
              </div>
            </div>
            <h3 class="text-lg font-serif font-bold text-white mb-1 group-hover:text-amber-500 transition-colors">
              {item.data.title}
            </h3>
            <p class="text-stone-400 text-sm mb-2">{item.data.subcategory}</p>
            <p class="text-amber-500 font-bold font-serif">€{item.data.price?.toLocaleString() || 'N/A'}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-[#003000] border-y border-white/5">
    <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="order-2 md:order-1 aspect-video bg-stone-800 flex items-center justify-center text-stone-500 italic rounded-lg shadow-xl border border-white/5">
        [Image: Close-up of restoration work]
      </div>
      <div class="order-1 md:order-2">
        <h2 class="text-4xl font-serif font-bold text-white mb-6">Услуги по възстановяване на антики</h2>
        <p class="text-stone-300 mb-8 leading-relaxed">
          Нашите майстори занаятчии се специализират в вдъхването на нов живот на повредени антики, като същевременно запазват оригиналния им характер и историческа цялост.
        </p>
        <ul class="space-y-4 mb-10">
          <li class="flex items-center text-stone-200">
            <span class="w-6 h-6 bg-amber-700 text-white rounded-full flex items-center justify-center text-xs mr-3 font-bold">✓</span>
            Традиционно френско полиране
          </li>
          <li class="flex items-center text-stone-200">
            <span class="w-6 h-6 bg-amber-700 text-white rounded-full flex items-center justify-center text-xs mr-3 font-bold">✓</span>
            Ремонт на антикварни часовници
          </li>
          <li class="flex items-center text-stone-200">
            <span class="w-6 h-6 bg-amber-700 text-white rounded-full flex items-center justify-center text-xs mr-3 font-bold">✓</span>
            Обшивка с периодични тъкани
          </li>
        </ul>
        <a href="/contact" class="inline-block border-2 border-white text-white px-8 py-3 rounded font-bold hover:bg-white hover:text-[#003000] transition-all">
          Запитване за възстановяване
        </a>
      </div>
    </div>
  </section>
</Layout>
</Layout>