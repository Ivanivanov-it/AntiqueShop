---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="py-20 bg-stone-100 border-b border-stone-200">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl font-serif font-bold text-stone-800 mb-6">Our History & Legacy</h1>
      <p class="text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed">
        Preserving the past, one piece at a time. We've been sourcing the world's most unique treasures for over three decades.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-3xl font-serif font-bold text-stone-800 mb-6">A Passion for the Timeless</h2>
        <p class="text-stone-600 mb-4 text-lg">
          Our journey began in a small workshop in 1985. Driven by a passion for historical craftsmanship, we've grown into a premier destination for antique enthusiasts and collectors worldwide.
        </p>
        <p class="text-stone-600 mb-6">
          Every item in our collection is hand-selected for its quality, history, and character. We believe that antiques aren't just objects; they're storytellers that bridge the gap between generations.
        </p>
        <div class="border-l-4 border-amber-700 pl-6 italic text-stone-700 text-lg py-2">
          "Antiques are the only items that get more beautiful and more valuable with time. They are the true sustainable choice for a modern home."
        </div>
      </div>
      <div class="relative">
        <div class="aspect-square bg-stone-300 rounded-lg overflow-hidden shadow-2xl flex items-center justify-center text-stone-500 italic">
          [Image: Vintage Workshop Interior]
        </div>
        <div class="absolute -bottom-6 -left-6 bg-amber-700 text-white p-8 rounded shadow-xl hidden md:block">
          <p class="text-3xl font-bold">35+</p>
          <p class="text-sm uppercase tracking-widest">Years of Expertise</p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-stone-900 text-white py-20">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
        <div>
          <div class="text-amber-500 mb-4 text-4xl">★</div>
          <h3 class="text-xl font-bold mb-2">Curated Quality</h3>
          <p class="text-stone-400">Rigorously inspected and authenticated by our team of experts.</p>
        </div>
        <div>
          <div class="text-amber-500 mb-4 text-4xl">⟳</div>
          <h3 class="text-xl font-bold mb-2">Global Sourcing</h3>
          <p class="text-stone-400">Sourcing unique pieces from Europe, Asia, and across the Americas.</p>
        </div>
        <div>
          <div class="text-amber-500 mb-4 text-4xl">♥</div>
          <h3 class="text-xl font-bold mb-2">Personal Service</h3>
          <p class="text-stone-400">Bespoke sourcing and restoration services for discerning clients.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
