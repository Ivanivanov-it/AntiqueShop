---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="py-16 bg-stone-100 border-b border-stone-200">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl font-serif font-bold text-stone-800 mb-2">Get in Touch</h1>
      <p class="text-stone-600">Have a question about a piece or looking to sell? We'd love to hear from you.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-20">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-16">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-serif font-bold text-stone-800 mb-8">Send Us a Message</h2>
        <form class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-2">Full Name</label>
              <input type="text" placeholder="John Doe" class="w-full bg-white border border-stone-200 px-4 py-3 rounded focus:outline-none focus:ring-1 focus:ring-amber-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-2">Email Address</label>
              <input type="email" placeholder="john@example.com" class="w-full bg-white border border-stone-200 px-4 py-3 rounded focus:outline-none focus:ring-1 focus:ring-amber-500" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Subject</label>
            <select class="w-full bg-white border border-stone-200 px-4 py-3 rounded focus:outline-none focus:ring-1 focus:ring-amber-500">
              <option>General Inquiry</option>
              <option>Sell Your Antique</option>
              <option>Authentication Request</option>
              <option>Sourcing Assistance</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Your Message</label>
            <textarea rows="6" placeholder="How can we help you?" class="w-full bg-white border border-stone-200 px-4 py-3 rounded focus:outline-none focus:ring-1 focus:ring-amber-500 resize-none"></textarea>
          </div>
          <button type="submit" class="bg-amber-700 text-white px-8 py-4 rounded font-bold hover:bg-amber-800 transition-colors shadow-lg">
            Send Message
          </button>
        </form>
      </div>

      <div class="bg-stone-50 p-10 border border-stone-200 rounded-lg shadow-sm">
        <h2 class="text-2xl font-serif font-bold text-stone-800 mb-8 text-center">Contact Details</h2>
        <div class="space-y-10">
          <div>
            <p class="text-amber-700 font-bold uppercase tracking-widest text-xs mb-3">Our Location</p>
            <p class="text-stone-800 font-medium">123 Heritage Lane, Old Town District<br/>Antique City, AC 12345</p>
          </div>
          <div>
            <p class="text-amber-700 font-bold uppercase tracking-widest text-xs mb-3">Reach Us</p>
            <p class="text-stone-800 font-medium">Email: hello@antiqueshop.com</p>
            <p class="text-stone-800 font-medium">Phone: +1 (555) 123-4567</p>
          </div>
          <div>
            <p class="text-amber-700 font-bold uppercase tracking-widest text-xs mb-3">Store Hours</p>
            <ul class="space-y-1 text-sm text-stone-700">
              <li class="flex justify-between"><span>Monday - Friday:</span> <span>9:00 - 18:00</span></li>
              <li class="flex justify-between"><span>Saturday:</span> <span>10:00 - 16:00</span></li>
              <li class="flex justify-between font-bold text-stone-400"><span>Sunday:</span> <span>Closed</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="h-96 bg-stone-300 flex items-center justify-center text-stone-500 italic text-xl border-t border-stone-200">
    [Interactive Map Component Placeholder]
  </div>
</Layout>
