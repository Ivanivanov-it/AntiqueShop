---
import Layout from '../../layouts/Layout.astro';
import { localizedPath, staticLocalePaths } from '../../utils/i18n.js';
import { categories, getCategoryName, getSlug } from '../../utils/categories.js';

export function getStaticPaths() {
  return staticLocalePaths();
}

const currentLocale = Astro.currentLocale || 'bg';
const bgCopy = {
    eyebrow: 'Колекции',
    title: 'Влезте в света на колекцията',
    description: 'Подбрани категории от автентични антики, носещи следи от различни епохи и култури.',
    imageAltPrefix: 'Антикварни предмети и артефакти от категория',
    helpTitle: 'Търсите нещо конкретно?',
    helpText: 'Ако търсите определен антикварен предмет, можем да ви съдействаме с насоки и препоръки за неговото откриване.',
    contact: 'Свържете се с нас',
};

const enCopy = {
    eyebrow: 'Collections',
    title: 'Step into the collection',
    description: 'Curated categories of authentic antiques carrying traces of different periods and cultures.',
    imageAltPrefix: 'Antique objects and artifacts in the category',
    helpTitle: 'Looking for something specific?',
    helpText: 'If you are searching for a particular antique object, we can help with guidance and recommendations for finding it.',
    contact: 'Contact us',
};

const copy = currentLocale === 'en' ? enCopy : bgCopy;
---

<Layout bodyClass="bg-stone-50" title={{ bg: "Категории", en: "Categories" }} description={{ bg: "Разгледайте категории от автентични антики, редки предмети и колекционерски обекти.", en: "Browse categories of authentic antiques, rare objects, and collectible pieces." }}>
  <div class="border-b border-stone-200 bg-stone-100 py-14 sm:py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.24em] text-amber-700">{copy.eyebrow}</span>
        <h1 class="font-serif text-4xl font-bold leading-tight text-stone-950 sm:text-5xl">{copy.title}</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg">{copy.description}</p>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-10 sm:py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {categories.map((category) => (
        <a href={localizedPath(currentLocale, `/categories/${getSlug(category)}`)} class="group block h-full">
          <article class="relative h-full overflow-hidden rounded-lg border border-stone-200 bg-stone-950 shadow-lg shadow-stone-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-amber-600/70 hover:shadow-xl hover:shadow-stone-950/10">
            <div class="relative aspect-[4/5] overflow-hidden bg-stone-200">
              {category.image ? (
                <img
                  src={category.image}
                  alt={`${copy.imageAltPrefix} ${getCategoryName(category, currentLocale)}`}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center px-6 text-center text-stone-500 italic">
                  {getCategoryName(category, currentLocale)}
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-950/25 to-transparent opacity-95 transition-opacity duration-300 group-hover:opacity-85"></div>
              <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
                <div class="mb-4 h-px w-14 bg-amber-500/80 transition-all duration-300 group-hover:w-24"></div>
                <div class="flex items-end justify-between gap-4">
                  <h3 class="font-serif text-2xl font-bold leading-tight text-white sm:text-3xl">
                    {getCategoryName(category, currentLocale)}
                  </h3>
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/30 bg-white/10 text-xl leading-none text-white transition-all duration-300 group-hover:border-amber-400 group-hover:bg-amber-500 group-hover:text-stone-950" aria-hidden="true">
                    &rarr;
                  </span>
                </div>
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>
  </div>

  <div class="border-y border-amber-100 bg-amber-50 py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="mb-4 font-serif text-3xl font-bold text-stone-800">{copy.helpTitle}</h2>
      <p class="mx-auto mb-8 max-w-xl text-stone-600">
        {copy.helpText}
      </p>
      <a href={localizedPath(currentLocale, "/contact")} class="inline-block rounded bg-stone-800 px-8 py-3 text-white transition-colors hover:bg-stone-700">
         {copy.contact}
      </a>
    </div>
  </div>
</Layout>


