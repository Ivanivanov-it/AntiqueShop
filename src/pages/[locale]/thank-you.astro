---
import Layout from '../../layouts/Layout.astro';
import { localizedPath, staticLocalePaths } from '../../utils/i18n.js';

export function getStaticPaths() {
  return staticLocalePaths();
}

const currentLocale = Astro.currentLocale || 'bg';
const bgCopy = {
    title: 'Благодарим ви!',
    text: 'Вашето съобщение беше изпратено успешно. Ще се свържем с вас възможно най-скоро на посочения от вас имейл адрес.',
    home: 'Към началната страница',
    categories: 'Разгледайте категориите',
};

const enCopy = {
    title: 'Thank you!',
    text: 'Your message was sent successfully. We will contact you as soon as possible at the email address you provided.',
    home: 'Back to the homepage',
    categories: 'Browse categories',
};

const copy = currentLocale === 'en' ? enCopy : bgCopy;
---

<Layout title={{ bg: "Благодарим ви", en: "Thank you" }} description={{ bg: "Потвърждение за успешно изпратено съобщение към Antique Shop.", en: "Confirmation that your message to Antique Shop was sent successfully." }}>
  <div class="py-24 bg-stone-100 min-h-[70vh] flex items-center justify-center">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-2xl mx-auto bg-white p-12 rounded-lg shadow-sm border border-stone-200">
        <div class="w-20 h-20 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center mx-auto mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-10 h-10">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <h1 class="text-4xl font-serif font-bold text-stone-800 mb-4">{copy.title}</h1>
        <p class="text-xl text-stone-600 mb-10">
          {copy.text}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href={localizedPath(currentLocale)} class="bg-amber-700 text-white px-8 py-3 rounded font-bold hover:bg-amber-800 transition-colors shadow-md">
            {copy.home}
          </a>
          <a href={localizedPath(currentLocale, "/categories")} class="bg-stone-100 text-stone-800 px-8 py-3 rounded font-bold hover:bg-stone-200 transition-colors border border-stone-200">
            {copy.categories}
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>


