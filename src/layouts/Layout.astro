---
import "../styles/global.css";
import { categories, getSlug } from "../utils/categories.js";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Antique Shop</title>
	</head>
	<body class="bg-stone-50 text-stone-900 flex flex-col min-h-screen">
		<header class="bg-white shadow-sm sticky top-0 z-50">
			<nav class="container mx-auto px-4 py-6 flex justify-between items-center">
				<a href="/"><img src="/src/assets/images/AntiqueShopLogo.png" alt="Antique Shop" class="h-24" /></a>
				<ul class="flex space-x-8 font-medium">
					<!-- <li><a href="/" class="hover:text-amber-700 transition-colors">Home</a></li> -->
					<li><a href="/categories" class="hover:text-amber-700 transition-colors">Категории</a></li>
					<li><a href="/about" class="hover:text-amber-700 transition-colors">За нас</a></li>
					<li><a href="/contact" class="hover:text-amber-700 transition-colors">Контакти</a></li>
				</ul>
			</nav>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-stone-900 text-stone-300 py-12 mt-20">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div>
						<h3 class="text-xl font-serif font-bold text-white mb-4">Антикварен магазин Берлин</h3>
						<p class="text-sm leading-relaxed">
							Запазване на историята чрез безвременни произведения. Ние източваме най-добрите антики от цял свят, за да донесем характер и душа на вашия дом.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-4">Категории</h3>
						<ul class="space-y-2 text-sm">
							{categories.slice(0, 10).map(category => (
								<li><a href={`/categories/${getSlug(category)}`} class="hover:text-amber-500 transition-colors">{category.name}</a></li>
							))}
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-4">Бързи връзки</h3>
						<ul class="space-y-2 text-sm">
							<li><a href="/about" class="hover:text-amber-500 transition-colors">За нас</a></li>
							<li><a href="/contact" class="hover:text-amber-500 transition-colors">Свържете се с нас</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-4">Абонамент</h3>
						<p class="text-sm mb-4">Абонирайте се, за да получавате актуализации за нашите най-нови продукти.</p>
						<form class="flex">
							<input type="email" placeholder="Вашият имейл" class="bg-stone-800 border-stone-700 text-white px-4 py-2 rounded-l focus:outline-none focus:ring-1 focus:ring-amber-500 w-full" />
							<button type="submit" class="bg-amber-700 hover:bg-amber-600 text-white px-4 py-2 rounded-r transition-colors">Присъединяване</button>
						</form>
					</div>
				</div>
				<div class="border-t border-stone-800 mt-12 pt-8 text-center text-xs">
					&copy; {new Date().getFullYear()} AntiqueShop. All rights reserved.
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
