---
import "../styles/global.css";
import { categories, getCategoryDescription, getCategoryName, getSlug } from "../utils/categories.js";
import { locales, localizedPath, switchLocalePath, t } from "../utils/i18n.js";

const { bodyClass = "bg-stone-50", title, description } = Astro.props;
type Locale = "bg" | "en";
type LocalizedProp = string | Partial<Record<Locale, string>> | undefined;

const currentLocale: Locale = Astro.currentLocale === "en" ? "en" : "bg";
const content = t(currentLocale);
const localizeProp = (value: LocalizedProp) => typeof value === "object" && value !== null ? value[currentLocale] || value.bg : value;
const currentPath = Astro.url.pathname;
const currentPathWithoutLocale = currentPath.replace(/^\/(bg|en)(?=\/|$)/, "") || "/";
const localizedTitle = localizeProp(title);
const pageTitle = localizedTitle ? `${localizedTitle} | ${content.seo.siteName}` : content.seo.siteName;
const pageDescription = localizeProp(description) || content.seo.description;
const urlBase = Astro.site || Astro.url.origin;
const canonicalUrl = new URL(currentPath, urlBase);
const ogImageUrl = new URL("/images/AntiqueShopLogo.png", urlBase);
const seoKeywords = currentLocale === "bg"
	? [
		"Варна",
		"Антики",
		"Антикварен магазин",
		"Антикварен магазин Варна",
		"Антикварен магазин Берлин",
		"Берлин",
		"антикварни предмети",
		"старинни предмети",
		"колекционерски предмети",
		"порцелан",
		"старинни часовници",
	]
	: [
		"Varna",
		"antiques",
		"antique shop",
		"antique shop Varna",
		"antique shop Berlin",
		"Berlin",
		"vintage objects",
		"collectibles",
		"porcelain antiques",
		"antique watches",
	];
const structuredData = {
	"@context": "https://schema.org",
	"@type": "Store",
	name: content.seo.siteName,
	url: canonicalUrl.origin,
	image: ogImageUrl.href,
	description: pageDescription,
	keywords: seoKeywords.join(", "),
	email: "antiqueshop.berlin@gmail.com",
	telephone: "+359895361505",
	address: {
		"@type": "PostalAddress",
		streetAddress: "бул. Княгиня Мария Луиза 5А",
		addressLocality: "Варна",
		postalCode: "9000",
		addressCountry: "BG",
	},
	areaServed: [
		{ "@type": "City", name: "Варна" },
		{ "@type": "City", name: "Берлин" },
	],
};
const alternateUrls = locales.map((locale) => ({
	locale,
	href: new URL(localizedPath(locale, currentPathWithoutLocale), urlBase),
}));
const nextLocale = currentLocale === "bg" ? "en" : "bg";
const nav = content.nav;
const footer = content.footer;
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="keywords" content={seoKeywords.join(", ")} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="author" content={content.seo.siteName} />
		<link rel="canonical" href={canonicalUrl.href} />
		{alternateUrls.map(({ locale, href }) => <link rel="alternate" hreflang={locale} href={href.href} />)}
		<link rel="alternate" hreflang="x-default" href={alternateUrls.find(({ locale }) => locale === "bg")?.href.href} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={content.seo.siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:image" content={ogImageUrl.href} />
		<meta property="og:locale" content={currentLocale === "bg" ? "bg_BG" : "en_US"} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl.href} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class={`${bodyClass} text-stone-900 flex flex-col min-h-screen`}>
		<header class="bg-white shadow-sm sticky top-0 z-50">
			<nav class="container mx-auto flex flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center sm:justify-between lg:py-5">
				<a href={localizedPath(currentLocale)} class="flex justify-center sm:justify-start"><img src="/images/AntiqueShopLogo.png" alt="Antique Shop" class="h-16 w-auto sm:h-20 lg:h-24" /></a>
				<ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-sm font-semibold uppercase tracking-wide text-stone-800 sm:justify-end sm:text-base sm:normal-case sm:tracking-normal">
					<li class="group relative w-full sm:w-auto" data-category-nav>
						<button type="button" class="inline-flex w-full items-center justify-center gap-1.5 py-2 transition-colors hover:text-amber-700 sm:hidden" aria-haspopup="true" aria-expanded="false" aria-controls="category-menu" data-category-toggle>
							{nav.categories}
							<svg class="h-3.5 w-3.5 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-category-icon>
								<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
							</svg>
						</button>
						<a href={localizedPath(currentLocale, "/categories")} class="hidden w-full items-center justify-center gap-1.5 py-2 hover:text-amber-700 transition-colors sm:inline-flex sm:w-auto" aria-haspopup="true">
							{nav.categories}
							<svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
							</svg>
						</a>
						<div id="category-menu" class="z-50 hidden w-full opacity-0 transition duration-150 sm:invisible sm:absolute sm:left-1/2 sm:top-full sm:block sm:w-[min(92vw,54rem)] sm:-translate-x-1/2 sm:pt-3 sm:group-hover:visible sm:group-hover:opacity-100 sm:group-focus-within:visible sm:group-focus-within:opacity-100" data-category-menu>
							<div class="overflow-hidden rounded-lg border border-stone-200 bg-white text-left normal-case tracking-normal shadow-xl ring-1 ring-black/5 sm:shadow-2xl">
								<div class="flex items-center justify-between gap-4 border-b border-stone-100 bg-stone-50 px-4 py-3 sm:px-5 sm:py-4">
									<span class="text-xs font-bold uppercase tracking-[0.18em] text-stone-500">{nav.categories}</span>
									<a href={localizedPath(currentLocale, "/categories")} class="text-sm font-bold text-amber-800 transition-colors hover:text-amber-950">
										{currentLocale === "bg" ? "Всички" : "All"}
									</a>
								</div>
								<div class="grid max-h-[min(62vh,30rem)] gap-1 overflow-y-auto p-2 sm:max-h-[70vh] sm:grid-cols-2 sm:p-3 lg:grid-cols-3">
									{categories.map((category) => (
										<a href={localizedPath(currentLocale, `/categories/${getSlug(category)}`)} class="group/category grid grid-cols-[3.25rem_1fr] gap-3 rounded-md p-2.5 transition-colors hover:bg-amber-50 focus-visible:bg-amber-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 sm:grid-cols-[3.75rem_1fr] sm:p-3">
											<img src={category.image} alt="" class="h-12 w-12 rounded-md object-cover ring-1 ring-stone-200 sm:h-14 sm:w-14" loading="lazy" />
											<span class="min-w-0">
												<span class="block text-sm font-bold leading-snug text-stone-900 transition-colors group-hover/category:text-amber-800">{getCategoryName(category, currentLocale)}</span>
												<span class="mt-1 line-clamp-2 block text-xs font-medium leading-relaxed text-stone-500">{getCategoryDescription(category, currentLocale)}</span>
											</span>
										</a>
									))}
								</div>
							</div>
						</div>
					</li>
					<li><a href={localizedPath(currentLocale, "/about")} class="hover:text-amber-700 transition-colors">{nav.about}</a></li>
					<li><a href={localizedPath(currentLocale, "/contact")} class="hover:text-amber-700 transition-colors">{nav.contact}</a></li>
					<li>
						<a href={switchLocalePath(currentPath, nextLocale)} hreflang={nextLocale} aria-label={nav.switchAria} class="rounded border border-amber-700 px-3 py-2 text-xs font-bold uppercase tracking-wide text-amber-800 transition-colors hover:bg-amber-700 hover:text-white">
							{nav.switchLabel}
						</a>
					</li>
				</ul>
			</nav>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-stone-950 text-stone-300">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.1fr_1fr_1fr_1fr_1.1fr] lg:gap-10 lg:py-16">
					<div class="text-center sm:text-left">
						<a href={localizedPath(currentLocale)} class="mb-5 inline-flex justify-center sm:justify-start">
							<img src="/images/AntiqueShopLogo.png" alt="Antique Shop Logo" class="h-20 w-auto brightness-0 invert sm:h-24" loading="lazy" />
						</a>
						<p class="mx-auto max-w-xs text-sm leading-relaxed text-stone-400 sm:mx-0">{footer.intro}</p>
					</div>
					<div class="text-center sm:text-left">
						<h3 class="mb-5 text-sm font-bold uppercase tracking-[0.18em] text-white">{footer.categories}</h3>
						<ul class="grid grid-cols-1 gap-3 text-sm sm:gap-2">
							{categories.slice(0, 10).map((category) => (
								<li><a href={localizedPath(currentLocale, `/categories/${getSlug(category)}`)} class="hover:text-amber-500 transition-colors">{getCategoryName(category, currentLocale)}</a></li>
							))}
						</ul>
					</div>
					<div class="text-center sm:text-left">
						<h3 class="mb-5 text-sm font-bold uppercase tracking-[0.18em] text-white">{footer.quickLinks}</h3>
						<ul class="mb-8 space-y-3 text-sm">
							<li><a href={localizedPath(currentLocale, "/about")} class="hover:text-amber-500 transition-colors">{footer.about}</a></li>
							<li><a href={localizedPath(currentLocale, "/contact")} class="hover:text-amber-500 transition-colors">{footer.contactLink}</a></li>
						</ul>
						<h3 class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-white">{footer.follow}</h3>
						<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 hover:text-amber-500 transition-colors group">
							<div class="w-10 h-10 bg-stone-800 rounded-full flex items-center justify-center group-hover:bg-amber-700 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
									<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
								</svg>
							</div>
							<span class="text-sm font-medium">Instagram</span>
						</a>
					</div>
					<div class="text-center sm:text-left">
						<h3 class="mb-5 text-sm font-bold uppercase tracking-[0.18em] text-white">{footer.terms}</h3>
						<ul class="space-y-3 text-sm">
							<li><a href={localizedPath(currentLocale, "/nachini-na-plashtane")} class="hover:text-amber-500 transition-colors">{footer.payment}</a></li>
						</ul>
					</div>
					<div class="text-center sm:text-left">
						<h3 class="mb-5 text-sm font-bold uppercase tracking-[0.18em] text-white">{footer.contacts}</h3>
						<div class="space-y-4 text-sm leading-relaxed text-stone-400">
							<p>
								<span class="block font-semibold text-stone-200">{footer.shopName}</span>
								{footer.shopText}
							</p>
							<a href={localizedPath(currentLocale, "/contact")} class="inline-flex rounded border border-amber-600/60 px-5 py-3 text-xs font-bold uppercase tracking-wide text-amber-400 transition-colors hover:bg-amber-600 hover:text-stone-950">
								{footer.contactLink}
							</a>
						</div>
					</div>
				</div>
				<div class="border-t border-stone-800 py-6 text-center text-xs text-stone-500 sm:flex sm:items-center sm:justify-between sm:text-left">
					&copy; {new Date().getFullYear()} AntiqueShopBerlin. {footer.rights}
					<span class="mt-2 block sm:mt-0">{footer.tagline}</span>
				</div>
			</div>
		</footer>
		<script is:inline>
			(() => {
				if (!/(invite_token|confirmation_token|recovery_token|email_change_token|access_token|error)=/.test(window.location.hash)) {
					return;
				}

				const script = document.createElement("script");
				script.src = "https://identity.netlify.com/v1/netlify-identity-widget.js";
				script.onload = () => {
					const identity = window.netlifyIdentity;
					if (!identity) return;

					identity.on("init", (user) => {
						if (!user) {
							identity.on("login", () => {
								document.location.href = "/admin/";
							});
						}
					});
					identity.init();
				};
				document.head.append(script);
			})();
		</script>
		<script is:inline>
			const categoryNav = document.querySelector("[data-category-nav]");
			const categoryToggle = categoryNav?.querySelector("[data-category-toggle]");
			const categoryMenu = categoryNav?.querySelector("[data-category-menu]");
			const categoryIcon = categoryNav?.querySelector("[data-category-icon]");

			if (categoryNav instanceof HTMLElement && categoryToggle instanceof HTMLButtonElement && categoryMenu instanceof HTMLElement) {
				const setCategoryMenuOpen = (isOpen) => {
					categoryToggle.setAttribute("aria-expanded", String(isOpen));
					categoryMenu.classList.toggle("hidden", !isOpen);
					categoryMenu.classList.toggle("opacity-0", !isOpen);
					categoryMenu.classList.toggle("opacity-100", isOpen);
					categoryIcon?.classList.toggle("rotate-180", isOpen);
				};

				categoryToggle.addEventListener("click", () => {
					setCategoryMenuOpen(categoryToggle.getAttribute("aria-expanded") !== "true");
				});

				document.addEventListener("click", (event) => {
					if (!categoryNav.contains(event.target instanceof Node ? event.target : null)) {
						setCategoryMenuOpen(false);
					}
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape") {
						setCategoryMenuOpen(false);
					}
				});
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
