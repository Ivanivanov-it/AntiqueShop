---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Antique Shop</title>
	</head>
	<body class="bg-stone-50 text-stone-900 flex flex-col min-h-screen">
		<header class="bg-white shadow-sm sticky top-0 z-50">
			<nav class="container mx-auto px-4 py-6 flex justify-between items-center">
				<a href="/" class="text-2xl font-serif font-bold text-stone-800">Antique<span class="text-amber-700">Shop</span></a>
				<ul class="flex space-x-8 font-medium">
					<!-- <li><a href="/" class="hover:text-amber-700 transition-colors">Home</a></li> -->
					<li><a href="/categories" class="hover:text-amber-700 transition-colors">Categories</a></li>
					<li><a href="/about" class="hover:text-amber-700 transition-colors">About</a></li>
					<li><a href="/contact" class="hover:text-amber-700 transition-colors">Contact</a></li>
				</ul>
			</nav>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-stone-900 text-stone-300 py-12 mt-20">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					<div>
						<h3 class="text-xl font-serif font-bold text-white mb-4">AntiqueShop</h3>
						<p class="text-sm leading-relaxed">
							Preserving history through timeless pieces. We source the finest antiques from around the world to bring character and soul to your home.
						</p>
					</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-4">Quick Links</h3>
						<ul class="space-y-2 text-sm">
							<li><a href="/categories" class="hover:text-amber-500 transition-colors">Shop by Category</a></li>
							<li><a href="/about" class="hover:text-amber-500 transition-colors">Our History</a></li>
							<li><a href="/contact" class="hover:text-amber-500 transition-colors">Get in Touch</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-4">Newsletter</h3>
						<p class="text-sm mb-4">Subscribe to get updates on our latest arrivals.</p>
						<form class="flex">
							<input type="email" placeholder="Your email" class="bg-stone-800 border-stone-700 text-white px-4 py-2 rounded-l focus:outline-none focus:ring-1 focus:ring-amber-500 w-full" />
							<button type="submit" class="bg-amber-700 hover:bg-amber-600 text-white px-4 py-2 rounded-r transition-colors">Join</button>
						</form>
					</div>
				</div>
				<div class="border-t border-stone-800 mt-12 pt-8 text-center text-xs">
					&copy; {new Date().getFullYear()} AntiqueShop. All rights reserved.
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
