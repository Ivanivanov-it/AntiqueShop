---
import "../styles/global.css";
import { categories, getSlug } from "../utils/categories.js";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Antique Shop</title>
	</head>
	<body class="bg-stone-50 text-stone-900 flex flex-col min-h-screen">
		<header class="bg-white shadow-sm sticky top-0 z-50">
			<nav class="container mx-auto px-4 py-6 flex justify-between items-center">
				<a href="/"><img src="/src/assets/images/AntiqueShopLogo.png" alt="Antique Shop" class="h-24" /></a>
				<ul class="flex space-x-8 font-medium">
					<!-- <li><a href="/" class="hover:text-amber-700 transition-colors">Home</a></li> -->
					<li><a href="/categories" class="hover:text-amber-700 transition-colors">Категории</a></li>
					<li><a href="/about" class="hover:text-amber-700 transition-colors">За нас</a></li>
					<li><a href="/contact" class="hover:text-amber-700 transition-colors">Контакти</a></li>
				</ul>
			</nav>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-stone-900 text-stone-300 py-16 mt-20">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
					<div class="flex flex-col items-center md:items-start">
						<a href="/" class="inline-block mb-6">
							<img src="/src/assets/images/AntiqueShopLogo.png" alt="Antique Shop Logo" class="h-24 brightness-0 invert" />
						</a>
					</div>
					<div class="text-center md:text-left">
						<h3 class="text-lg font-bold text-white mb-6 uppercase tracking-wider">Категории</h3>
						<ul class="space-y-3 text-sm">
							{categories.slice(0, 10).map(category => (
								<li><a href={`/categories/${getSlug(category)}`} class="hover:text-amber-500 transition-colors">{category.name}</a></li>
							))}
						</ul>
					</div>
					<div class="text-center md:text-left">
						<h3 class="text-lg font-bold text-white mb-6 uppercase tracking-wider">Бързи връзки</h3>
						<ul class="space-y-3 text-sm mb-8">
							<li><a href="/about" class="hover:text-amber-500 transition-colors">За нас</a></li>
							<li><a href="/contact" class="hover:text-amber-500 transition-colors">Свържете се с нас</a></li>
						</ul>
						<h3 class="text-lg font-bold text-white mb-4 uppercase tracking-wider">Последвайте ни</h3>
						<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 hover:text-amber-500 transition-colors group">
							<div class="w-10 h-10 bg-stone-800 rounded-full flex items-center justify-center group-hover:bg-amber-700 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
									<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
								</svg>
							</div>
							<span class="text-sm font-medium">Instagram</span>
						</a>
					</div>
					<div class="text-center md:text-left">
						<h3 class="text-lg font-bold text-white mb-6 uppercase tracking-wider">Абонамент</h3>
						<p class="text-sm mb-6 leading-relaxed">Абонирайте се, за да получавате актуализации за нашите най-нови продукти.</p>
						<form class="flex shadow-lg">
							<input type="email" placeholder="Вашият имейл" class="bg-stone-800 border-none text-white px-4 py-3 rounded-l focus:outline-none focus:ring-1 focus:ring-amber-500 w-full text-sm" />
							<button type="submit" class="bg-amber-700 hover:bg-amber-600 text-white px-6 py-3 rounded-r transition-colors text-sm font-bold flex items-center justify-center">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
								</svg>
							</button>
						</form>
					</div>
				</div>
				<div class="border-t border-stone-800 mt-12 pt-8 text-center text-xs">
					&copy; {new Date().getFullYear()} AntiqueShop. All rights reserved.
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
